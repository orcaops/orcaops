{
  "name": "orcaops",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "release:cli": "node scripts/build-cli-dist.mjs",
    "release:watch": "node scripts/build-watch-dist.mjs",
    "verify:publishable": "node scripts/verify-publishable.mjs",
    "install:loop": "node scripts/install-loop.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "typecheck:tests": "turbo run typecheck:tests",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "test:ci": "pnpm run check:source-nul && pnpm --filter @orcaops/evaluator-pack build && pnpm --filter @orcaops/project-scope test && pnpm --filter @orcaops/watch build && pnpm --filter @orcaops/watch test && pnpm --filter @orcaops/watch test:render && pnpm --filter @orcaops/watch test:pty && pnpm --filter @orcaops/watch perf:review-cap && pnpm --filter @orcaops/watch perf:review && pnpm --filter @orcaops/cli test:coverage",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "prepare": "husky install",
    "syncpack:list": "syncpack list",
    "syncpack:fix": "syncpack fix-mismatches",
    "check:source-nul": "node scripts/check-source-nul.mjs",
    "check:dependency-policy": "node scripts/check-dependency-policy.mjs",
    "check:public-content": "node scripts/check-public-content.mjs",
    "audit:prod:ci": "node scripts/run-production-audit.mjs",
    "test:dependency-guardrails": "vitest run --config scripts/vitest.config.ts",
    "qualify:public-release": "node scripts/qualify-public-release.mjs",
    "unsafecleandep": "rm -rf node_modules && pnpm -r exec rm -rf node_modules"
  },
  "type": "module",
  "devDependencies": {
    "@orcaops/cli": "workspace:*",
    "@orcaops/eslint-config": "workspace:*",
    "@orcaops/prettier-config": "workspace:*",
    "@orcaops/typescript-config": "workspace:*",
    "@orcaops/watch": "workspace:*",
    "@types/node": "24.3.1",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.2",
    "prettier": "^3.6.2",
    "syncpack": "^12.3.3",
    "turbo": "2.8.20",
    "typescript": "5.9.2",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.2"
}
