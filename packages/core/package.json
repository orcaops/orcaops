{
  "name": "@orcaops/core",
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./history": {
      "types": "./dist/history/index.d.ts",
      "default": "./dist/history/index.js"
    },
    "./history/search": {
      "types": "./dist/history/search/index.d.ts",
      "default": "./dist/history/search/index.js"
    },
    "./history/registration": {
      "types": "./dist/history/registration-files.d.ts",
      "default": "./dist/history/registration-files.js"
    },
    "./history/database-setup": {
      "types": "./dist/history/database-setup-api.d.ts",
      "default": "./dist/history/database-setup-api.js"
    },
    "./history/database-read": {
      "types": "./dist/history/database-read-api.d.ts",
      "default": "./dist/history/database-read-api.js"
    },
    "./history/database-retention": {
      "types": "./dist/history/database-retention-api.d.ts",
      "default": "./dist/history/database-retention-api.js"
    },
    "./history/database-checkout": {
      "types": "./dist/history/database-checkout-api.d.ts",
      "default": "./dist/history/database-checkout-api.js"
    },
    "./history/database-capture": {
      "types": "./dist/history/database-capture-api.d.ts",
      "default": "./dist/history/database-capture-api.js"
    },
    "./history/database-push": {
      "types": "./dist/history/database-push-api.d.ts",
      "default": "./dist/history/database-push-api.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "node ../../scripts/run-vitest.mjs",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@orcaops/diff-fingerprint": "0.0.8",
    "@orcaops/protocol": "0.0.26",
    "@orcaops/sdk": "0.1.23",
    "@orcaops/storage": "workspace:*",
    "conventional-commits-parser": "^7.1.2",
    "zod": "^4.0.17"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@orcaops/eslint-config": "workspace:*",
    "@orcaops/prettier-config": "workspace:*",
    "@orcaops/test-harness": "workspace:*",
    "@orcaops/typescript-config": "workspace:*",
    "vitest": "^4.0.18"
  }
}
