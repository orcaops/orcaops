{
  "name": "@orcaops/review-engine",
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "fixtures:check": "node scripts/generate-synthetic-confirmation-fixtures.mjs --check",
    "fixtures:generate": "node scripts/generate-synthetic-confirmation-fixtures.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm run typecheck:contracts",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:contracts": "tsc --noEmit -p tsconfig.contract-tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "prettier": "@orcaops/prettier-config",
  "dependencies": {
    "@orcaops/core": "workspace:*",
    "@orcaops/evaluator-protocol": "workspace:*",
    "@orcaops/project-scope": "workspace:*",
    "@orcaops/review-core": "workspace:*",
    "@orcaops/storage": "workspace:*",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@orcaops/eslint-config": "workspace:*",
    "@orcaops/prettier-config": "workspace:*",
    "@orcaops/test-harness": "workspace:*",
    "@orcaops/typescript-config": "workspace:*",
    "typescript": "5.9.2",
    "vitest": "^4.0.18"
  }
}
