{
  "name": "@orcaops/review-core",
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@orcaops/diff-fingerprint": "0.0.8",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@orcaops/eslint-config": "workspace:*",
    "@orcaops/prettier-config": "workspace:*",
    "@orcaops/test-harness": "workspace:*",
    "@orcaops/typescript-config": "workspace:*",
    "typescript": "5.9.2",
    "vitest": "^4.0.18"
  }
}
